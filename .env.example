# ===== Mode Supabase (produksi) =====
# Isi dua baris ini setelah membuat project Supabase dan menjalankan supabase/schema.sql.
# Kalau kosong, aplikasi jalan dalam Mode Lokal (data tersimpan di data/lab.json).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Akun admin pertama =====
# Dipakai sekali saat belum ada pengguna sama sekali (bootstrap admin).
# Setelah admin pertama jadi, ganti kata sandinya dari menu Profil.
LAB_ADMIN_EMAIL=
LAB_ADMIN_PASSWORD=
LAB_ADMIN_NAMA=Admin Lab

# ===== Rahasia sesi login =====
# Wajib diganti dengan teks acak panjang di produksi.
LAB_SESSION_SECRET=

# Alamat publik aplikasi (untuk link di hasil ekspor, opsional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
